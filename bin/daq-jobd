#!/usr/bin/env bash
# bin/daq-jobd
# Host side of the daq-jobd job service (jobd/daq_jobd.py), which runs inside
# dunedaq-app, or natively on a Linux host (--conf). Clients talk to it over MCP;
# see jobd/README.md.
#
# Usage (container, on the Mac):
#   bin/daq-jobd mcp              MCP server on stdin/stdout (what .mcp.json runs)
#   bin/daq-jobd wait ID [SECS]   block until request ID ends, polling its state file on
#                                 the host every SECS (default 15); prints
#                                 "REQUEST-ENDED <status> <id>". For Monitor/background use.
#   bin/daq-jobd submit|result|list|cancel|snapshot ...   the daq_jobd.py command line, in the container
#   bin/daq-jobd top [--interval S] [--hosts local,NAME,...] [--once] [--json]
#                                 read-only monitor of this container and the native hosts
#                                 in jobd/native_hosts (default all); see jobd/monitor.py
#
# Native host (run there, e.g. over ssh): the service runs directly, with its settings
# from CONF (see jobd/native.conf.example):
#   bin/daq-jobd --conf CONF mcp|submit|result|list|cancel|wait|snapshot ...
#
# Your own machine, for native hosts:
#   bin/daq-jobd remote-add [--host NAME | --base URL] DIR...   add a git remote for a
#       native host's mirror to each repo in DIR (a repo, or a work area: its sourcecode/*
#       and pythoncode/*), pointing at <mirror>/<repo>.git. NAME is from jobd/native_hosts
#       (default fnal, remote `daqfnal`); --base URL overrides its mirror (or $DAQFNAL_BASE
#       for fnal).
#
# Every start copies jobd/daq_jobd.py to work/.daq-jobd/ (the container sees only
# /work) and reaps locks left by dead host-side bin/daq-job runners, which the
# container cannot check. DAQ_JOBS_DIR (a /work/... path) selects another job
# directory, e.g. for testing.

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$HERE")"
CONTAINER="dunedaq-app"
JOBS_CTR="${DAQ_JOBS_DIR:-/work/.daq-jobs}"

die() { echo "daq-jobd: $*" >&2; exit "${2:-2}"; }

# Host directory mounted at /work (also the prefix for host paths in results).
host_work() {
  podman inspect "$CONTAINER" \
    --format '{{range .Mounts}}{{if eq .Destination "/work"}}{{.Source}}{{end}}{{end}}' 2>/dev/null
}

running() { podman ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER}$"; }

install_service() {
  local dest="$1/.daq-jobd"
  mkdir -p "$dest"
  if ! cmp -s "$ROOT/jobd/daq_jobd.py" "$dest/daq_jobd.py"; then
    cp "$ROOT/jobd/daq_jobd.py" "$dest/daq_jobd.py.tmp.$$"
    mv "$dest/daq_jobd.py.tmp.$$" "$dest/daq_jobd.py"
  fi
}

in_container() {  # in_container HOST_WORK [podman exec flags] -- args...
  local hw="$1"; shift
  local flags=()
  while [ "$1" != "--" ]; do flags+=("$1"); shift; done; shift
  # The host's timezone, so job ids (timestamps) sort together with bin/daq-job's.
  local tz; tz=$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')
  exec podman exec ${flags[@]+"${flags[@]}"} -e DAQ_HOST_WORK="$hw" -e DAQ_JOBS_DIR="$JOBS_CTR" -e TZ="${tz:-UTC}" \
    "$CONTAINER" python3 -I /work/.daq-jobd/daq_jobd.py "$@"
}

cmd_wait() {
  local id=${1:?request id} every=${2:-15} hw st
  hw=$(host_work); [ -n "$hw" ] || hw="$ROOT/work"
  local f="$hw${JOBS_CTR#/work}/requests/$id.state"
  [ -f "$f" ] || die "no request $id ($f)"
  while :; do
    st=$(cat "$f" 2>/dev/null || true)
    case "$st" in
      ok|failed|cancelled) echo "REQUEST-ENDED $st $id"; return 0 ;;
    esac
    # A runner that died never writes a final state; ask the service.
    if [ -n "$(find "$f" -mmin +30 2>/dev/null)" ] && running \
       && "$0" result "$id" | grep -q '"status": "lost"'; then
      echo "REQUEST-ENDED lost $id"; return 0
    fi
    sleep "$every"
  done
}

# native_host NAME: that host's line from jobd/native_hosts (NAME SSH_HOST REMOTE CHECKOUT CONF MIRROR).
native_host() {
  awk -v n="$1" '$1 == n { print; found = 1 } END { exit !found }' "$ROOT/jobd/native_hosts" ||
    die "no host $1 in jobd/native_hosts"
}

cmd_remote_add() {
  local name=fnal base="" dir repo url have line ssh_host remote mirror
  while :; do
    case "${1:-}" in
      --host) name=$2; shift 2 ;;
      --base) base=$2; shift 2 ;;
      *) break ;;
    esac
  done
  line=$(native_host "$name")
  set -- $line "$@"  # NAME SSH_HOST REMOTE CHECKOUT CONF MIRROR DIR...
  ssh_host=$2 remote=$3 mirror=${6//\$USER/$USER}
  shift 6
  [ "$name" = fnal ] && [ -z "$base" ] && base=${DAQFNAL_BASE:-}
  base=${base:-$ssh_host:$mirror}
  [ $# -gt 0 ] || die "remote-add: give a repo or work area directory"
  for dir in "$@"; do
    if [ -d "$dir/.git" ]; then set -- "$dir"
    else set -- "$dir"/sourcecode/*/ "$dir"/pythoncode/*/; fi
    for repo in "$@"; do
      repo=${repo%/}
      [ -d "$repo/.git" ] || continue
      url="$base/$(basename "$repo").git"
      if have=$(git -C "$repo" remote get-url "$remote" 2>/dev/null); then
        [ "$have" = "$url" ] && echo "ok       $repo" || echo "SKIP     $repo: $remote is already $have" >&2
      else
        git -C "$repo" remote add "$remote" "$url" && echo "added    $repo -> $remote $url"
      fi
    done
  done
}

if [ "${1:-}" = --conf ]; then
  conf=${2:?--conf needs a file}; shift 2
  [ -f "$conf" ] || die "no config file $conf"
  export DAQ_JOBD_CONF="$(cd "$(dirname "$conf")" && pwd)/$(basename "$conf")"
  case "${1:-}" in
    mcp|submit|result|list|cancel|wait|snapshot) exec python3 -I "$ROOT/jobd/daq_jobd.py" "$@" ;;
    *) sed -n '2,33p' "$0"; exit 2 ;;
  esac
fi

sub=${1:-}; shift || true
case "$sub" in
  wait) cmd_wait "$@" ;;
  remote-add) cmd_remote_add "$@" ;;
  top) exec python3 -I "$ROOT/jobd/monitor.py" "$@" ;;
  mcp|submit|result|list|cancel|snapshot)
    running || die "container $CONTAINER is not running; run bin/daq-stack ensure" 3
    hw=$(host_work); [ -n "$hw" ] || die "cannot find the host directory mounted at /work" 3
    install_service "$hw"
    # snapshot only reads, and the monitor calls it every few seconds: skip the reap.
    [ "$sub" = snapshot ] ||
      DAQ_JOBS_HOST_DIR="$hw${JOBS_CTR#/work}" "$HERE/daq-job" reap >/dev/null 2>&1 || true
    if [ "$sub" = mcp ]; then in_container "$hw" -i -- mcp
    else in_container "$hw" -- "$sub" "$@"; fi
    ;;
  *) sed -n '2,33p' "$0"; exit 2 ;;
esac
